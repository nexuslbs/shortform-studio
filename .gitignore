# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Test / tooling caches
.pytest_cache/
.coverage
htmlcov/

# Secrets and local configuration - never commit these
.env
*.token
*oauth*.json
client_secret*.json
credentials.json

# Generated pipeline output: the repository is source-only. Runtime artifacts
# live under the external data root ($SHORTFORM_ARTIFACTS_DIR or
# {OMNI_DIR}/data/artifacts/shortform-studio); `out/` is ignored wholesale and
# there is deliberately NO committed-video exception.
out/

# Local measurement snapshots (the default target is the external data root)
data/metrics/

# Billing / storefront runtime rows. The directories stay trackable via
# .gitkeep; the append-only rows never enter the repository.
ledger/*.jsonl
storefront/ledger/*.jsonl

# SQLite store: the schema/migrations live in-repo, the database never does.
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# A local data root accidentally pointed inside the repo (second line of
# defence; the default is always outside the tree).
artifacts/
store/

# Editor / OS noise
.DS_Store
*.swp
