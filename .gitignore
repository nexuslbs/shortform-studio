# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Test / tooling caches
.pytest_cache/
.coverage
htmlcov/

# Secrets and local configuration - never commit these
.env
*.token
*oauth*.json
client_secret*.json
credentials.json

